rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isVerifiedAdmin() {
      return isSignedIn()
        && request.auth.token.email == "deepakrajpant978@gmail.com"
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isVerifiedAdmin();
      allow create: if isOwner(uid)
                    && !('premium' in request.resource.data
                         && request.resource.data.premium != null)
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'active';
      allow update: if isVerifiedAdmin()
                    || (isOwner(uid) && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['name','photoURL','lastLogin','bestScore','bookmarks','streak']));
      allow delete: if isVerifiedAdmin();

      match /results/{attemptId} {
        allow read: if isOwner(uid) || isVerifiedAdmin();
        allow create: if isOwner(uid);
        allow update, delete: if isVerifiedAdmin();
      }
    }

    match /accessRequests/{requestId} {
      allow read: if isVerifiedAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isVerifiedAdmin();
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
    match /jftoctnovset/{docId} {
      allow read: if true;
      allow write: if isVerifiedAdmin();
    }
    match /adminAuditLogs/{logId} {
      allow read: if isVerifiedAdmin();
      allow create: if isVerifiedAdmin();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
